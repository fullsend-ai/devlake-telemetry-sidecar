# DevLake API base URL. Leave empty to start the server with collectors disabled.
DEVLAKE_URL=

# Probe loop interval (seconds).
PROBE_INTERVAL_SECONDS=30

# Pipeline poll interval (seconds).
PIPELINE_POLL_INTERVAL_SECONDS=60

# Management server listen port.
METRICS_PORT=9090

# Expose /debug/pprof on the management port. Off by default.
ENABLE_PPROF=false
